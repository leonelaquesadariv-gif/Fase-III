@startuml
title SIMU - Modelo C4 Nivel 3: Componentes del Backend
top to bottom direction
skinparam componentStyle rectangle
component "Aplicación web" as Web
rectangle "Servidor / Backend SIMU" {
  component "Inicio de sesión" as Login
  component "Gestión de estudiantes" as Est
  component "Gestión de cursos" as Cursos
  component "Matrícula" as Mat
  component "Validación de cupos\ny conflictos de horario" as Val
  component "Reportes" as Rep
  component "Acceso a datos" as Datos
}
database "Base de datos" as DB
Web --> Login
Web --> Est
Web --> Cursos
Web --> Mat
Web --> Rep
Mat --> Val
Login --> Datos
Est --> Datos
Cursos --> Datos
Mat --> Datos
Val --> Datos
Rep --> Datos
Datos --> DB
@enduml
