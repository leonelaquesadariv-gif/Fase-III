@startuml
title SIMU - Modelo C4 Nivel 2: Contenedores
left to right direction
skinparam componentStyle rectangle
actor Usuario
rectangle "Sistema SIMU" {
  component "Aplicación web\nInterfaz de usuario" as Web
  component "Servidor / Backend\nLógica del sistema" as Back
  database "Base de datos\nUsuarios, cursos, horarios y matrículas" as DB
  component "Módulo de reportes\nHorarios, PDF y Excel" as Rep
}
Usuario --> Web : Utiliza el sistema
Web --> Back : Envía solicitudes
Back --> DB : Consulta y guarda información
Back --> Rep : Solicita reportes
Rep --> DB : Consulta datos
@enduml
