@startuml
title Sistema de Matrícula Universitaria - Casos de Uso

left to right direction

actor Estudiante
actor Administrador

rectangle "Sistema de Matrícula Universitaria" {

usecase "Registrarse" as UC1
usecase "Iniciar sesión" as UC2
usecase "Consultar oferta de cursos" as UC3
usecase "Matricular cursos" as UC4
usecase "Validar prerrequisitos" as UC5
usecase "Verificar cupos" as UC6
usecase "Validar choque de horarios" as UC7
usecase "Agregar/Eliminar cursos" as UC8
usecase "Consultar horario" as UC9
usecase "Descargar horario" as UC10

usecase "Gestionar cursos" as UC11
usecase "Crear curso" as UC12
usecase "Modificar curso" as UC13
usecase "Eliminar curso" as UC14
usecase "Generar reportes" as UC15

}

Estudiante --> UC1
Estudiante --> UC2
Estudiante --> UC3
Estudiante --> UC4
Estudiante --> UC8
Estudiante --> UC9
Estudiante --> UC10

Administrador --> UC11
Administrador --> UC15

UC4 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
UC4 .> UC7 : <<include>>

UC11 .> UC12 : <<include>>
UC11 .> UC13 : <<include>>
UC11 .> UC14 : <<include>>

@enduml