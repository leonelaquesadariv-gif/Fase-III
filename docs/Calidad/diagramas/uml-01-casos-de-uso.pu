@startuml
title Sistema Integral de Matrícula Universitaria - Casos de Uso

left to right direction

actor Estudiante
actor Administrador
actor Docente

rectangle "SIMU" {
  usecase "Registrarse" as UC1
  usecase "Iniciar sesión" as UC2
  usecase "Consultar oferta de cursos" as UC3
  usecase "Matricular cursos" as UC4
  usecase "Validar prerrequisitos" as UC5
  usecase "Verificar cupos" as UC6
  usecase "Validar choque de horarios" as UC7
  usecase "Agregar / eliminar cursos" as UC8
  usecase "Consultar horario" as UC9
  usecase "Descargar / imprimir horario" as UC10

  usecase "Gestionar cursos y grupos" as UC11
  usecase "Crear curso o grupo" as UC12
  usecase "Modificar curso o grupo" as UC13
  usecase "Eliminar curso o grupo" as UC14
  usecase "Gestionar cupos y horarios" as UC15
  usecase "Generar reportes" as UC16

  usecase "Consultar grupos asignados" as UC17
  usecase "Consultar estudiantes matriculados" as UC18
}

Estudiante --> UC1
Estudiante --> UC2
Estudiante --> UC3
Estudiante --> UC4
Estudiante --> UC8
Estudiante --> UC9
Estudiante --> UC10

Administrador --> UC2
Administrador --> UC11
Administrador --> UC15
Administrador --> UC16

Docente --> UC2
Docente --> UC9
Docente --> UC17
Docente --> UC18

UC4 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
UC4 .> UC7 : <<include>>

UC11 .> UC12 : <<include>>
UC11 .> UC13 : <<include>>
UC11 .> UC14 : <<include>>

@enduml
